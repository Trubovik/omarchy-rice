{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "#f57396",
      "2": "#fab387",
      "3": "#f5c2e7"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "#fce5eb"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "color": {
        "user": "#f57396"
      }
    },
    "break",
    {
      "type": "os",
      "key": "󱄅 os ",
      "keyColor": "#f57396"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "#fab387"
    },
    {
      "type": "memory",
      "key": "󰘚 ram",
      "keyColor": "#f5c2e7"
    },
    {
      "type": "shell",
      "key": " sh ",
      "keyColor": "#cba6f7"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
