    border-radius: 12px;
    padding: 16px;
}
.account-card {
    background-color: alpha(@window_fg_color, 0.04);
    border: 1px solid alpha(@window_fg_color, 0.08);
    border-radius: 12px;
    padding: 14px;
    margin-bottom: 10px;
}
.account-card-active {
    background-color: alpha(@accent_color, 0.08);
    border: 1.5px solid alpha(@accent_color, 0.5);
    border-radius: 12px;
