#!/usr/bin/env python3
"""
Antigravity Multi-Account Dashboard (agy-accounts-gui)
Modern Libadwaita / GTK4 application for managing Google Antigravity accounts,
monitoring real-time token consumption, quota resets, and auto-rotation readiness.
"""

import sys
import os
import time
import subprocess
from pathlib import Path

# Add backend directory
sys.path.insert(0, str(Path.home() / ".local" / "bin"))
import agy_accounts_backend as backend

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, GLib, Gdk, Pango

APP_ID = "org.omarchy.AntigravityAccounts"

CUSTOM_CSS = """
.status-badge-active {
    background-color: alpha(@accent_color, 0.25);
    color: @accent_color;
    border: 1px solid alpha(@accent_color, 0.6);
    border-radius: 9999px;
    padding: 3px 10px;
    font-weight: bold;
    font-size: 11px;
}
.status-badge-ready {
    background-color: alpha(#26a269, 0.2);
    color: #2ec27e;
    border: 1px solid alpha(#2ec27e, 0.5);
